{
  "name": "tilemma",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "validate:levels": "tsx scripts/validate-levels.ts",
    "author:levels": "tsx scripts/author-levels.ts",
    "gen:lean-tests": "tsx scripts/gen-lean-tests.ts",
    "test:lean": "cd lean && lake build && lake env lean Tests/Positive.lean && lake env lean Tests/Negative.lean && lake env lean Tests/LevelSolutions.lean",
    "difftest": "tsx scripts/difftest.ts",
    "bench": "tsx scripts/bench.ts",
    "e2e": "playwright test",
    "test:docker": "tsx scripts/docker-security.ts && tsx scripts/load.ts",
    "test:all": "pnpm typecheck && pnpm lint && pnpm build && pnpm test && pnpm validate:levels && pnpm gen:lean-tests && pnpm test:lean && pnpm difftest && pnpm e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@pp/engine": "workspace:*",
    "@types/node": "^22.20.5",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "zod": "^3.25.76"
  }
}
